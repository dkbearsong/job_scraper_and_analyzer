# ==============================================================================
# Job Scraper and Analyzer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. FILE & DIRECTORY PATHS
# ──────────────────────────────────────────────────────────────────────────────

# Path to your resume in .docx format
RESUME='documents/Your Resume.docx'

# Path to your user profile plain-text file (must contain Skills: and Job Titles:)
PROFILE='documents/User Profile.txt'

# Path to benchmark archetypes JSON configuration
ARCHETYPES_CONFIG='documents/archetypes_config.json'

# Path to the scraper adapter configuration YAML
SCRAPERS_CONFIG='scrapers_config.yaml'

# Path to user preferences YAML (filtering rules, LLM model mappings, rate limits)
USER_PREFERENCES_YAML='user_preferences.yaml'

# Path to company career sites CSV (used by legacy fallback / microservice)
JOB_SITES='job_sites.csv'

# Path to search queries for job board scraping (JobSpy)
SEARCH_TERMS='documents/search_terms.csv'

# Path to Adzuna search queries CSV (used by AdzunaAdapter)
ADZUNDA_SEARCHES_CSV='documents/adzunda_searches.csv'

# Optional: Path to HiringCafe URLs CSV (if using HiringCafeAdapter)
HIRING_CAFE_URLS_CSV='documents/hiring_cafe_urls.csv'


# ──────────────────────────────────────────────────────────────────────────────
# 2. POSTGRESQL DATABASE CONFIGURATION (pgvector required)
# ──────────────────────────────────────────────────────────────────────────────

DB_NAME='job_searcher'
DB_USER='postgres'
DB_PASSWORD='your_postgres_password_here'
DB_HOST='localhost'
DB_PORT='5432'


# ──────────────────────────────────────────────────────────────────────────────
# 3. SCRAPER CONFIGURATION & API KEYS
# ──────────────────────────────────────────────────────────────────────────────

# Adzuna Job Search API (Free API credentials: https://developer.adzuna.com/)
ADZUNA_APP_ID='your_adzuna_app_id_here'
ADZUNA_APP_KEY='your_adzuna_app_key_here'

# Career Page Microservice (Only needed if using MicroserviceAdapter on company career pages)
SCRAPER_HOST='localhost'
SCRAPER_PORT='5052'
MICROSERVICE_TIMEOUT=120

# Optional: CAPTCHA Solving Service (Supported: "2captcha" or "capsolver")
CAPTCHA_SERVICE='2captcha'
# TWOCAPTCHA_API_KEY='your_2captcha_key'
# CAPSOLVER_API_KEY='your_capsolver_key'


# ──────────────────────────────────────────────────────────────────────────────
# 4. LLM PROVIDERS — API KEYS & ENDPOINTS
# ──────────────────────────────────────────────────────────────────────────────
# Note: Model assignments per stage are configured in user_preferences.yaml.
# Set API keys for whichever providers you plan to use:

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY='your_gemini_api_key_here'

# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY='your_openrouter_api_key_here'
OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY='your_openai_api_key_here'

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY='your_anthropic_api_key_here'

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY='your_groq_api_key_here'

# Cohere API (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY='your_cohere_api_key_here'

# NVIDIA NIM API (https://build.nvidia.com/)
NVIDIA_API_KEY='your_nvidia_api_key_here'

# HuggingFace API (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY='your_huggingface_api_key_here'

# SiliconFlow API (https://cloud.siliconflow.cn/)
SILICONFLOW_API_KEY='your_siliconflow_api_key_here'

# LM Studio (Local inference: https://lmstudio.ai/)
LMS_URL='http://localhost'
LMS_PORT='1234'
LMS_API_KEY='lm-studio'

# Ollama (Local inference: https://ollama.com/)
OLLAMA_URL='http://localhost'
OLLAMA_PORT='11434'
OLLAMA_API_KEY=''


# ──────────────────────────────────────────────────────────────────────────────
# 5. CONCURRENCY & RATE LIMITING TIERS
# ──────────────────────────────────────────────────────────────────────────────
# Defines whether each pipeline stage uses 'free' or 'paid' tier rate-limits
# (as specified in user_preferences.yaml) to throttle requests and avoid 429 errors.

CONCURRENCY_MODE='concurrent'
STAGE_2_EXTRACTION_TIER='paid'
STAGE_2_EMBEDDING_TIER='paid'
STAGE_6_TIER='free'
STAGE_7_TIER='free'
